rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // הפרויקט אינו פעיל - כל המידע חסום, גישה לאדמין בלבד.
    // אין כאן כלל לכתיבה עצמית למשתמשים, כדי שמשתמש לא יוכל לשנות לעצמו תפקיד.

    // משתמש מחובר יכול לקרוא רק את המסמך של עצמו
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }

    // כל שאר הגישה - אדמין בלבד
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // פונקציות עזר
    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.role == 'admin' ||
              (request.auth.token.email == 'yair.hutterer@gmail.com' &&
               request.auth.token.email_verified == true));
    }
  }
}
